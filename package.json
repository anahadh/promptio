{
  "name": "promptio",
  "version": "0.0.1",
  "description": "Rewrites chat prompts for a chosen mode, part by part.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:decompose": "tsx scripts/decompose-demo.ts",
    "demo:analyze": "tsx scripts/analyze-demo.ts",
    "jev:viewer": "tsx scripts/jev-viewer.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "zod": "^4.6.7"
  }
}
