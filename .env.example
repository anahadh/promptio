# Copy to .env.local (gitignored) for local scripts such as the live demos.
# The extension itself never reads these: users paste their own keys in its settings page (BYOK, D3).

# Anthropic API key, used by Haiku 5.5 (decomposer, rewriter)
ANTHROPIC_API_KEY=

# TypeSafe API key, used by Jev (presence and specificity scoring)
TYPESAFE_API_KEY=
